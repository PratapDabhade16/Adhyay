# ====================================================================
# ADHYAY — Environment Configuration Template
# Copy this file to .env and provide your production credentials
# Do NOT commit actual .env files to version control
# ====================================================================

# Database
MONGODB_URI=mongodb://localhost:27017/adhyay

# Application Server
SERVER_PORT=8081

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Moodle LMS Integration
MOODLE_BASE_URL=https://your-institution.moodlecloud.com
MOODLE_TOKEN=your_moodle_web_service_token

# Email Dispatcher (Resend API)
EMAIL_API_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=ADHYAY Walchand College

# Groq AI Provider (Whisper Audio Transcription & Chat Models)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_QUERY_EXPANSION_MODEL=openai/gpt-oss-20b

# Local FFmpeg Binary Path (optional override)
FFMPEG_PATH=ffmpeg

# JWT Authentication
# Minimum 256-bit (32 bytes) secret key for HMAC-SHA256 signature
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_at_least_32_characters_here
# 15 minutes = 900000 ms
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
# 7 days = 604800000 ms
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

